# Copy to .env.local and fill in. Enquiry & contact form emails are sent through SMTP.
#
# Gmail (haryana.260cp@gmail.com):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App password: Google Account → Security → App passwords.
#   3. Use that 16-character app password as SMTP_PASS (not the normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=haryana.260cp@gmail.com
SMTP_PASS=

# Inbox that receives website enquiries (defaults to the company email)
ENQUIRY_RECIPIENT_EMAIL=haryana.260cp@gmail.com
# "From" address; for Gmail this must be the SMTP_USER address
ENQUIRY_FROM_EMAIL=haryana.260cp@gmail.com

NEXT_PUBLIC_SITE_URL=https://www.hcpchem.com
